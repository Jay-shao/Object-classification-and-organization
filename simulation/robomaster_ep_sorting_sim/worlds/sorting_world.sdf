<?xml version="1.0"?>
<sdf version="1.8">
  <world name="sorting_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.82 0.86 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material><ambient>0.70 0.72 0.74 1</ambient><diffuse>0.70 0.72 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Nine 18 cm pickup grids in one straight line.  Centre spacing is
         42 cm, leaving 24 cm of clear separation between neighbouring cells. -->
    <model name="pickup_grid_1"><static>true</static><pose>1.20 -1.68 0.003 0 0 0</pose><link name="cell"><visual name="visual"><geometry><box><size>0.18 0.18 0.006</size></box></geometry><material><ambient>0.92 0.82 0.30 1</ambient><diffuse>0.92 0.82 0.30 1</diffuse></material></visual></link></model>
    <model name="pickup_grid_2"><static>true</static><pose>1.20 -1.26 0.003 0 0 0</pose><link name="cell"><visual name="visual"><geometry><box><size>0.18 0.18 0.006</size></box></geometry><material><ambient>0.92 0.82 0.30 1</ambient><diffuse>0.92 0.82 0.30 1</diffuse></material></visual></link></model>
    <model name="pickup_grid_3"><static>true</static><pose>1.20 -0.84 0.003 0 0 0</pose><link name="cell"><visual name="visual"><geometry><box><size>0.18 0.18 0.006</size></box></geometry><material><ambient>0.92 0.82 0.30 1</ambient><diffuse>0.92 0.82 0.30 1</diffuse></material></visual></link></model>
    <model name="pickup_grid_4"><static>true</static><pose>1.20 -0.42 0.003 0 0 0</pose><link name="cell"><visual name="visual"><geometry><box><size>0.18 0.18 0.006</size></box></geometry><material><ambient>0.92 0.82 0.30 1</ambient><diffuse>0.92 0.82 0.30 1</diffuse></material></visual></link></model>
    <model name="pickup_grid_5"><static>true</static><pose>1.20 0.00 0.003 0 0 0</pose><link name="cell"><visual name="visual"><geometry><box><size>0.18 0.18 0.006</size></box></geometry><material><ambient>0.92 0.82 0.30 1</ambient><diffuse>0.92 0.82 0.30 1</diffuse></material></visual></link></model>
    <model name="pickup_grid_6"><static>true</static><pose>1.20 0.42 0.003 0 0 0</pose><link name="cell"><visual name="visual"><geometry><box><size>0.18 0.18 0.006</size></box></geometry><material><ambient>0.92 0.82 0.30 1</ambient><diffuse>0.92 0.82 0.30 1</diffuse></material></visual></link></model>
    <model name="pickup_grid_7"><static>true</static><pose>1.20 0.84 0.003 0 0 0</pose><link name="cell"><visual name="visual"><geometry><box><size>0.18 0.18 0.006</size></box></geometry><material><ambient>0.92 0.82 0.30 1</ambient><diffuse>0.92 0.82 0.30 1</diffuse></material></visual></link></model>
    <model name="pickup_grid_8"><static>true</static><pose>1.20 1.26 0.003 0 0 0</pose><link name="cell"><visual name="visual"><geometry><box><size>0.18 0.18 0.006</size></box></geometry><material><ambient>0.92 0.82 0.30 1</ambient><diffuse>0.92 0.82 0.30 1</diffuse></material></visual></link></model>
    <model name="pickup_grid_9"><static>true</static><pose>1.20 1.68 0.003 0 0 0</pose><link name="cell"><visual name="visual"><geometry><box><size>0.18 0.18 0.006</size></box></geometry><material><ambient>0.92 0.82 0.30 1</ambient><diffuse>0.92 0.82 0.30 1</diffuse></material></visual></link></model>

    <!-- Six physical objects in two classes.  Grids 3, 6 and 8 are empty. -->
    <model name="object_grid_1"><static>true</static><pose>1.20 -1.68 0.030 0 0 0</pose><link name="object"><gravity>false</gravity><collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.90 0.08 0.05 1</ambient><diffuse>0.90 0.08 0.05 1</diffuse></material></visual></link></model>
    <model name="object_grid_2"><static>true</static><pose>1.20 -1.26 0.033 0 0 0</pose><link name="object"><gravity>false</gravity><collision name="collision"><geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry><material><ambient>0.05 0.25 0.92 1</ambient><diffuse>0.05 0.25 0.92 1</diffuse></material></visual></link></model>
    <model name="object_grid_4"><static>true</static><pose>1.20 -0.42 0.030 0 0 0</pose><link name="object"><gravity>false</gravity><collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.90 0.08 0.05 1</ambient><diffuse>0.90 0.08 0.05 1</diffuse></material></visual></link></model>
    <model name="object_grid_5"><static>true</static><pose>1.20 0.00 0.033 0 0 0</pose><link name="object"><gravity>false</gravity><collision name="collision"><geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry><material><ambient>0.05 0.25 0.92 1</ambient><diffuse>0.05 0.25 0.92 1</diffuse></material></visual></link></model>
    <model name="object_grid_7"><static>true</static><pose>1.20 0.84 0.030 0 0 0</pose><link name="object"><gravity>false</gravity><collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.90 0.08 0.05 1</ambient><diffuse>0.90 0.08 0.05 1</diffuse></material></visual></link></model>
    <model name="object_grid_9"><static>true</static><pose>1.20 1.68 0.033 0 0 0</pose><link name="object"><gravity>false</gravity><collision name="collision"><geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry><material><ambient>0.05 0.25 0.92 1</ambient><diffuse>0.05 0.25 0.92 1</diffuse></material></visual></link></model>

    <!-- Large open-front class bins.  Red/class_1 is left (+Y), blue/class_2
         is right (-Y).  Open fronts let the arm enter without a wall strike. -->
    <model name="class_1_left_bin">
      <static>true</static><pose>0.45 2.35 0 0 0 0</pose>
      <link name="bin">
        <collision name="floor_collision"><pose>0 0 0.015 0 0 0</pose><geometry><box><size>0.70 0.55 0.03</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 0.015 0 0 0</pose><geometry><box><size>0.70 0.55 0.03</size></box></geometry><material><ambient>0.75 0.05 0.04 1</ambient><diffuse>0.75 0.05 0.04 1</diffuse></material></visual>
        <collision name="left_wall_collision"><pose>0.335 0 0.13 0 0 0</pose><geometry><box><size>0.03 0.55 0.26</size></box></geometry></collision>
        <visual name="left_wall_visual"><pose>0.335 0 0.13 0 0 0</pose><geometry><box><size>0.03 0.55 0.26</size></box></geometry><material><ambient>0.85 0.08 0.06 1</ambient><diffuse>0.85 0.08 0.06 1</diffuse></material></visual>
        <collision name="right_wall_collision"><pose>-0.335 0 0.13 0 0 0</pose><geometry><box><size>0.03 0.55 0.26</size></box></geometry></collision>
        <visual name="right_wall_visual"><pose>-0.335 0 0.13 0 0 0</pose><geometry><box><size>0.03 0.55 0.26</size></box></geometry><material><ambient>0.85 0.08 0.06 1</ambient><diffuse>0.85 0.08 0.06 1</diffuse></material></visual>
        <collision name="back_wall_collision"><pose>0 0.26 0.13 0 0 0</pose><geometry><box><size>0.70 0.03 0.26</size></box></geometry></collision>
        <visual name="back_wall_visual"><pose>0 0.26 0.13 0 0 0</pose><geometry><box><size>0.70 0.03 0.26</size></box></geometry><material><ambient>0.85 0.08 0.06 1</ambient><diffuse>0.85 0.08 0.06 1</diffuse></material></visual>
      </link>
    </model>

    <model name="class_2_right_bin">
      <static>true</static><pose>0.45 -2.35 0 0 0 0</pose>
      <link name="bin">
        <collision name="floor_collision"><pose>0 0 0.015 0 0 0</pose><geometry><box><size>0.70 0.55 0.03</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 0.015 0 0 0</pose><geometry><box><size>0.70 0.55 0.03</size></box></geometry><material><ambient>0.04 0.20 0.78 1</ambient><diffuse>0.04 0.20 0.78 1</diffuse></material></visual>
        <collision name="left_wall_collision"><pose>0.335 0 0.13 0 0 0</pose><geometry><box><size>0.03 0.55 0.26</size></box></geometry></collision>
        <visual name="left_wall_visual"><pose>0.335 0 0.13 0 0 0</pose><geometry><box><size>0.03 0.55 0.26</size></box></geometry><material><ambient>0.05 0.25 0.90 1</ambient><diffuse>0.05 0.25 0.90 1</diffuse></material></visual>
        <collision name="right_wall_collision"><pose>-0.335 0 0.13 0 0 0</pose><geometry><box><size>0.03 0.55 0.26</size></box></geometry></collision>
        <visual name="right_wall_visual"><pose>-0.335 0 0.13 0 0 0</pose><geometry><box><size>0.03 0.55 0.26</size></box></geometry><material><ambient>0.05 0.25 0.90 1</ambient><diffuse>0.05 0.25 0.90 1</diffuse></material></visual>
        <collision name="back_wall_collision"><pose>0 -0.26 0.13 0 0 0</pose><geometry><box><size>0.70 0.03 0.26</size></box></geometry></collision>
        <visual name="back_wall_visual"><pose>0 -0.26 0.13 0 0 0</pose><geometry><box><size>0.70 0.03 0.26</size></box></geometry><material><ambient>0.05 0.25 0.90 1</ambient><diffuse>0.05 0.25 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Fixed RGB overview camera. -->
    <model name="sorting_overhead_camera">
      <static>true</static>
      <pose>1.10 0 4.20 0 1.570796 0</pose>
      <link name="camera_link">
        <sensor name="sorting_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>/sorting_camera/image</topic>
          <camera>
            <horizontal_fov>1.20</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.10</near><far>20.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
